# Content-hashed assets never change under the same name, so they may be cached
# for a year. The HTML is not listed here: it must always revalidate.
/joey-99628b37.webp
  Cache-Control: public, max-age=31536000, immutable
/joey-og-9006f6ca.jpg
  Cache-Control: public, max-age=31536000, immutable
/favicon-0ef66b21.png
  Cache-Control: public, max-age=31536000, immutable
/touch-208d2637.png
  Cache-Control: public, max-age=31536000, immutable

# HSTS: after one https visit, browsers refuse plain http for a year. This is
# the in-repo half of the http->https fix; the zone-level "Always Use HTTPS"
# toggle in the Cloudflare dashboard is the other half.
/*
  Strict-Transport-Security: max-age=31536000
